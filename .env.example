# Copy to `.env` and fill in. Never commit `.env`.

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
SITE_URL=https://www.filnews.fr

# Reddit API (create a "web app" on https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:8000/auth/reddit/callback
REDDIT_USER_AGENT=web:fr.filnews:v1.0 (by /u/your_username)

# Ingestion
FILNEWS_SUBREDDIT=france
FILNEWS_MIN_SCORE=250
# backfill_news: also keep the N best articles of each month / of each day.
FILNEWS_BACKFILL_TOP=60
FILNEWS_BACKFILL_DAY_TOP=2
FILNEWS_BACKFILL_DAY_MIN_SCORE=20

# Analysis: "heuristic" (default) or "local" (requires `pip install -e .[ml]`)
FILNEWS_ANALYZER=heuristic
